# ==========================================================
# Tarot Bot V3 — Environment Template
# ==========================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` to git — only `.env.example`.
# ==========================================================

# ----- Discord -----
# Get from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your_discord_bot_token_here
# Comma-separated Discord user IDs allowed to run bot admin commands.
BOT_ADMIN_IDS=789065787276132392

# ----- 9Router (sole AI provider) -----
# Set true to enable AI interpretation via 9Router.
# The bot never falls back to any other provider — when 9Router is down
# or returns garbage, the local card explanations are shown silently.
NINE_ROUTER_ENABLED=true
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=

# ----- AI model config -----
# Model name to use when the user hasn't picked their own (or picked "default").
NINE_ROUTER_MODEL=kr/claude-sonnet-4.5
# Per-request timeout in seconds (must be > 0).
NINE_ROUTER_API_TIMEOUT=120
# Max output tokens per response. Increase if you use long-form prompts.
NINE_ROUTER_MAX_OUTPUT_TOKENS=16384
# Sampling parameters.
NINE_ROUTER_TEMPERATURE=0.75
NINE_ROUTER_TOP_P=0.9
# Retry policy — silently retry transient failures (timeouts, 502/503/504,
# empty body) before falling back to the local card explanations.
NINE_ROUTER_MAX_RETRIES=6
NINE_ROUTER_RETRY_BACKOFF=1.0

# ----- Firebase (optional, for cloud sync) -----
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ----- Bot behaviour -----
SYNC_SLASH_COMMANDS=true

# id = Indonesian, en = English
DEFAULT_LANGUAGE=id

# simple / deep / gentle / direct
DEFAULT_READING_MODE=deep
# ----- Support / Donation -----
# Ko-fi link (used by /donate command)
DONATE_KOFI_URL=https://ko-fi.com/vv3yy
# Optional PayPal.me URL
DONATE_PAYPAL_URL=
# Optional custom message shown in the donate embed (leave empty for i18n default)
DONATE_MESSAGE=

# ----- Project Metadata (used by /source) -----
# Public source code repository
REPO_URL=https://github.com/Vey-Project/tarot-bot-discord
# SPDX license name shown in /source
LICENSE_NAME=MIT License
# Author/credits name shown in /source
AUTHOR_NAME=vv3yy